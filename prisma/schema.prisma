generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- AUTH & USERS ----------

enum Role {
  ADMIN
  EDITOR
  AGENT
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                    Account[]
  sessions                    Session[]
  favorites                   Favorite[]
  favoriteCollections         FavoriteCollection[]
  leads                       Lead[]
  appointments                Appointment[]
  agent                       Agent?
  messages                    Message[]
  permissions                 UserPermission[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  submittedProperties         Property[]              @relation("PropertySubmittedBy")
  approvedProperties          Property[]              @relation("PropertyApprovedBy")
  crmContactsOwned            CrmContact[]            @relation("CrmContactOwner")
  crmDealsOwned               CrmDeal[]               @relation("CrmDealOwner")
  crmActivities               CrmActivity[]           @relation("CrmActivityActor")
  crmCommunications           CrmCommunication[]      @relation("CrmCommunicationOwner")
  crmDocumentsUploaded        CrmDocument[]           @relation("CrmDocumentUploadedBy")
  crmSellerCasesOwned         CrmSellerCase[]         @relation("CrmSellerCaseOwner")
  crmOffersOwned              CrmOffer[]              @relation("CrmOfferOwner")
  crmAssignmentRules          CrmAssignmentRule[]     @relation("CrmAssignmentAssignee")
  crmSavedSearches            CrmSavedSearch[]
  crmAutomationTemplates      CrmAutomationTemplate[] @relation("CrmAutomationOwner")
  financingProfiles           FinancingProfile[]
  portalConversationsOwned    PortalConversation[]    @relation("PortalConversationsOwned")
  portalConversationsAssigned PortalConversation[]    @relation("PortalConversationsAssigned")
  portalMessagesSent          PortalMessage[]         @relation("PortalMessagesSent")
  agencySubscriptions         AgencySubscription[]
  agencyPayments              AgencyPayment[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // e.g. "properties.create"
  label String

  users UserPermission[]
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

// ---------- LOCATIONS ----------

model City {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  image              String?
  description        String?
  order              Int                 @default(0)
  neighborhoods      Neighborhood[]
  properties         Property[]
  crmSavedSearches   CrmSavedSearch[]
  crmAssignmentRules CrmAssignmentRule[]
}

model Neighborhood {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  cityId      String
  city        City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties  Property[]
}

// ---------- AGENCIES & AGENTS ----------

model Agency {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  coverImage  String?
  description String?
  phone       String?
  email       String?
  address     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  agents     Agent[]
  properties Property[]
}

model Agent {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  slug      String   @unique
  photo     String?
  bio       String?
  phone     String?
  email     String?
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id])
  createdAt DateTime @default(now())

  properties   Property[]
  appointments Appointment[]
  availability AgentAvailability[]
}

// ---------- PROPERTY CATALOG ----------

enum ListingType {
  VENTE
  LOCATION
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  UNDER_OFFER
  SOLD
  ARCHIVED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model PropertyType {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  icon               String?
  properties         Property[]
  crmSavedSearches   CrmSavedSearch[]
  crmAssignmentRules CrmAssignmentRule[]
}

model Amenity {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  icon       String?
  properties Property[]
}

model Property {
  id              String         @id @default(cuid())
  reference       String         @unique
  title           String
  titleEn         String?
  titleAr         String?
  slug            String         @unique
  description     String
  descriptionEn   String?
  descriptionAr   String?
  listingType     ListingType
  status          PropertyStatus @default(DRAFT)
  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedById   String?
  submittedBy     User?          @relation("PropertySubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?          @relation("PropertyApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  price           Int
  surfaceArea     Float
  bedrooms        Int            @default(0)
  bathrooms       Int            @default(0)
  floors          Int?
  yearBuilt       Int?
  latitude        Float?
  longitude       Float?
  address         String?
  featured        Boolean        @default(false)
  viewsCount      Int            @default(0)

  cityId         String
  city           City          @relation(fields: [cityId], references: [id])
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  propertyTypeId String
  propertyType   PropertyType  @relation(fields: [propertyTypeId], references: [id])
  agencyId       String?
  agency         Agency?       @relation(fields: [agencyId], references: [id])
  agentId        String?
  agent          Agent?        @relation(fields: [agentId], references: [id])

  amenities           Amenity[]
  media               Media[]
  ownerReports        OwnerReport[]
  leads               Lead[]
  favorites           Favorite[]
  appointments        Appointment[]
  crmDeals            CrmDeal[]
  crmDocuments        CrmDocument[]
  crmSellerCases      CrmSellerCase[]
  crmOffers           CrmOffer[]
  portalConversations PortalConversation[]

  seoTitle          String?
  seoTitleEn        String?
  seoTitleAr        String?
  seoDescription    String?
  seoDescriptionEn  String?
  seoDescriptionAr  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id             String              @id @default(cuid())
  url            String
  cloudinaryId   String?
  type           String              @default("image") // image | video | floorplan
  alt            String?
  order          Int                 @default(0)
  workflowStatus MediaWorkflowStatus @default(UPLOADED)
  reviewNote     String?
  processedAt    DateTime?
  propertyId     String?
  property       Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  blogPostId     String?
  blogPost       BlogPost?           @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
}

model Favorite {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   FavoriteCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@unique([userId, propertyId])
  @@index([userId, collectionId])
}

model FavoriteCollection {
  id        String     @id @default(cuid())
  name      String
  color     String?
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

// ---------- PORTAL MESSAGING ----------

enum PortalConversationStatus {
  OPEN
  CLOSED
}

model PortalConversation {
  id              String                   @id @default(cuid())
  propertyId      String
  property        Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User                     @relation("PortalConversationsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  assignedAgentId String?
  assignedAgent   User?                    @relation("PortalConversationsAssigned", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  subject         String?
  status          PortalConversationStatus @default(OPEN)
  lastMessageAt   DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  messages        PortalMessage[]

  @@unique([propertyId, ownerId])
  @@index([ownerId, status, lastMessageAt])
  @@index([assignedAgentId, status, lastMessageAt])
}

model PortalMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   PortalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User               @relation("PortalMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
}

// ---------- LEADS / APPOINTMENTS / MESSAGES ----------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id           String      @id @default(cuid())
  name         String
  email        String
  phone        String?
  message      String?
  status       LeadStatus  @default(NEW)
  position     Int         @default(0)
  source       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referrer     String?
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  propertyId   String?
  property     Property?   @relation(fields: [propertyId], references: [id])
  crmContactId String?
  crmContact   CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([crmContactId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MediaWorkflowStatus {
  UPLOADED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CrmDocumentVisibility {
  INTERNAL
  SELLER
}

enum CrmDocumentStatus {
  REQUESTED
  UPLOADED
  VERIFIED
  REJECTED
}

enum CrmSignatureStatus {
  DRAFT
  READY
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  FAILED
}

enum FinancingReadinessStatus {
  NEW
  REVIEWING
  PREQUALIFIED
  NOT_READY
}

enum OwnerReportStatus {
  DRAFT
  SENT
  SKIPPED
  FAILED
}

model Appointment {
  id                 String             @id @default(cuid())
  name               String
  email              String
  phone              String?
  date               DateTime
  durationMinutes    Int                @default(45)
  status             AppointmentStatus  @default(PENDING)
  notes              String?
  location           String?
  meetingUrl         String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  source             String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  userId             String?
  user               User?              @relation(fields: [userId], references: [id])
  propertyId         String?
  property           Property?          @relation(fields: [propertyId], references: [id])
  agentId            String?
  agent              Agent?             @relation(fields: [agentId], references: [id])
  availabilitySlotId String?
  availabilitySlot   AgentAvailability? @relation(fields: [availabilitySlotId], references: [id], onDelete: SetNull)
  crmContactId       String?
  crmContact         CrmContact?        @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([crmContactId])
  @@index([agentId, date])
  @@index([availabilitySlotId, date])
}

model AgentAvailability {
  id           String        @id @default(cuid())
  agentId      String
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int           @default(1)
  active       Boolean       @default(true)
  location     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([agentId, startsAt, active])
}

model Message {
  id           String      @id @default(cuid())
  name         String
  email        String
  subject      String?
  body         String
  read         Boolean     @default(false)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  crmContactId String?
  crmContact   CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([crmContactId])
}

enum CrmContactLifecycle {
  BUYER
  SELLER
  INVESTOR
  PARTNER
}

enum CrmCommunicationChannel {
  EMAIL
  WHATSAPP
  PHONE
  SMS
  IN_APP
}

enum CrmCommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CrmCommunicationStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  LOGGED
}

enum CrmSellerCaseStage {
  VALUATION_REQUESTED
  VALUATION_SCHEDULED
  MANDATE_PENDING
  ONBOARDING
  MEDIA_PREPARATION
  PUBLISHED
  OFFER_RECEIVED
  NEGOTIATION
  SOLD
  LOST
}

enum CrmOfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum CrmDocumentType {
  IDENTITY
  MANDATE
  TITLE_DEED
  FINANCING
  OFFER
  CONTRACT
  PROPERTY_MEDIA
  OTHER
}

enum CrmAlertChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

enum CrmDealStage {
  NEW
  QUALIFIED
  VIEWING
  OFFER
  NEGOTIATION
  WON
  LOST
}

enum CrmActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  TASK
  SYSTEM
}

model CrmContact {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  phone             String?
  source            String?
  notes             String?
  budgetMin         Int?
  budgetMax         Int?
  preferredLocation String?
  lifecycle         CrmContactLifecycle   @default(BUYER)
  leadScore         Int                   @default(0)
  scoreReason       String?
  lastContactedAt   DateTime?
  firstRespondedAt  DateTime?
  slaDueAt          DateTime?
  emailOptIn        Boolean               @default(true)
  whatsappOptIn     Boolean               @default(false)
  ownerId           String?
  owner             User?                 @relation("CrmContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads             Lead[]
  appointments      Appointment[]
  messages          Message[]
  deals             CrmDeal[]
  activities        CrmActivity[]
  communications    CrmCommunication[]
  documents         CrmDocument[]
  sellerCases       CrmSellerCase[]
  offers            CrmOffer[]
  signatureRequests CrmSignatureRequest[]
  financingProfiles FinancingProfile[]
  ownerReports      OwnerReport[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([ownerId, updatedAt])
}

model CrmDeal {
  id              String             @id @default(cuid())
  title           String
  stage           CrmDealStage       @default(NEW)
  value           Int?
  source          String?
  probability     Int                @default(10)
  nextFollowUpAt  DateTime?
  expectedCloseAt DateTime?
  wonAt           DateTime?
  lostReason      String?
  contactId       String
  contact         CrmContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId      String?
  property        Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?              @relation("CrmDealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities      CrmActivity[]
  communications  CrmCommunication[]
  documents       CrmDocument[]
  offers          CrmOffer[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([stage, ownerId, updatedAt])
  @@index([contactId, createdAt])
}

model CrmCommunication {
  id         String                    @id @default(cuid())
  channel    CrmCommunicationChannel
  direction  CrmCommunicationDirection
  status     CrmCommunicationStatus    @default(LOGGED)
  subject    String?
  body       String
  externalId String?
  sentAt     DateTime?
  contactId  String
  contact    CrmContact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       CrmDeal?                  @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?                     @relation("CrmCommunicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt  DateTime                  @default(now())

  @@index([contactId, createdAt])
  @@index([status, channel, createdAt])
}

model CrmDocument {
  id                 String                @id @default(cuid())
  name               String
  url                String
  type               CrmDocumentType       @default(OTHER)
  mimeType           String?
  sizeBytes          Int?
  visibility         CrmDocumentVisibility @default(INTERNAL)
  status             CrmDocumentStatus     @default(UPLOADED)
  requestedAt        DateTime?
  verifiedAt         DateTime?
  rejectedReason     String?
  externalStorageKey String?
  notes              String?
  contactId          String?
  contact            CrmContact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId             String?
  deal               CrmDeal?              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  propertyId         String?
  property           Property?             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById       String?
  uploadedBy         User?                 @relation("CrmDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  signatureRequests  CrmSignatureRequest[]
  createdAt          DateTime              @default(now())

  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
  @@index([propertyId, createdAt])
}

model CrmSellerCase {
  id                String                @id @default(cuid())
  title             String
  stage             CrmSellerCaseStage    @default(VALUATION_REQUESTED)
  estimatedValue    Int?
  mandateSigned     Boolean               @default(false)
  nextActionAt      DateTime?
  notes             String?
  contactId         String
  contact           CrmContact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId        String?
  property          Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?                 @relation("CrmSellerCaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  offers            CrmOffer[]
  signatureRequests CrmSignatureRequest[]
  ownerReports      OwnerReport[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([stage, ownerId, updatedAt])
  @@index([contactId, createdAt])
}

model CrmOffer {
  id                String                @id @default(cuid())
  amount            Int
  status            CrmOfferStatus        @default(SUBMITTED)
  message           String?
  conditions        String?
  expiresAt         DateTime?
  submittedAt       DateTime              @default(now())
  respondedAt       DateTime?
  contactId         String
  contact           CrmContact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId            String
  deal              CrmDeal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sellerCaseId      String?
  sellerCase        CrmSellerCase?        @relation(fields: [sellerCaseId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?                 @relation("CrmOfferOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  signatureRequests CrmSignatureRequest[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([propertyId, status, updatedAt])
  @@index([contactId, createdAt])
  @@index([sellerCaseId, updatedAt])
}

model CrmSignatureRequest {
  id           String             @id @default(cuid())
  title        String
  provider     String?
  status       CrmSignatureStatus @default(DRAFT)
  externalId   String?
  signingUrl   String?
  sentAt       DateTime?
  signedAt     DateTime?
  expiresAt    DateTime?
  error        String?
  contactId    String
  contact      CrmContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sellerCaseId String?
  sellerCase   CrmSellerCase?     @relation(fields: [sellerCaseId], references: [id], onDelete: SetNull)
  offerId      String?
  offer        CrmOffer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  documentId   String?
  document     CrmDocument?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([contactId, status, updatedAt])
  @@index([sellerCaseId, status])
}

model FinancingProfile {
  id              String                   @id @default(cuid())
  status          FinancingReadinessStatus @default(NEW)
  monthlyIncome   Int?
  monthlyDebt     Int?
  savings         Int?
  estimatedBudget Int?
  downPayment     Int?
  employmentType  String?
  preferredBank   String?
  bankPreApproved Boolean                  @default(false)
  consent         Boolean                  @default(false)
  notes           String?
  contactId       String
  contact         CrmContact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([contactId, status, updatedAt])
  @@index([userId, createdAt])
}

model OwnerReport {
  id           String            @id @default(cuid())
  status       OwnerReportStatus @default(DRAFT)
  periodStart  DateTime
  periodEnd    DateTime
  summary      Json
  deliveredAt  DateTime?
  error        String?
  contactId    String
  contact      CrmContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sellerCaseId String
  sellerCase   CrmSellerCase     @relation(fields: [sellerCaseId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@unique([sellerCaseId, periodStart, periodEnd])
  @@index([contactId, status, createdAt])
}

model CrmAssignmentRule {
  id             String        @id @default(cuid())
  name           String
  active         Boolean       @default(true)
  priority       Int           @default(100)
  source         String?
  cityId         String?
  city           City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  propertyTypeId String?
  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id], onDelete: SetNull)
  assigneeId     String
  assignee       User          @relation("CrmAssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([active, priority])
}

model CrmAutomationTemplate {
  id         String                  @id @default(cuid())
  name       String
  active     Boolean                 @default(true)
  trigger    String
  delayHours Int                     @default(0)
  channel    CrmCommunicationChannel
  subject    String?
  body       String
  ownerId    String?
  owner      User?                   @relation("CrmAutomationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([active, trigger])
}

model CrmSavedSearch {
  id             String          @id @default(cuid())
  name           String
  active         Boolean         @default(true)
  listingType    ListingType?
  minPrice       Int?
  maxPrice       Int?
  bedrooms       Int?
  cityId         String?
  city           City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  propertyTypeId String?
  propertyType   PropertyType?   @relation(fields: [propertyTypeId], references: [id], onDelete: SetNull)
  channel        CrmAlertChannel @default(EMAIL)
  lastNotifiedAt DateTime?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, active])
  @@index([active, lastNotifiedAt])
}

model CrmActivity {
  id          String          @id @default(cuid())
  type        CrmActivityType @default(NOTE)
  body        String
  dueAt       DateTime?
  completedAt DateTime?
  contactId   String
  contact     CrmContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        CrmDeal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?           @relation("CrmActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([contactId, createdAt])
  @@index([dealId, dueAt])
  @@index([dueAt, completedAt])
}

enum NotificationType {
  APPROVAL_REQUEST
  APPROVAL_DECISION
  LEAD_STATUS
  MESSAGE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  summary    String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ---------- BLOG / CMS ----------

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id         String        @id @default(cuid())
  title      String
  slug       String        @unique
  excerpt    String?
  content    String
  coverImage String?
  published  Boolean       @default(false)
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])
  media      Media[]

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String?
  quote     String
  rating    Int      @default(5)
  photo     String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------- SETTINGS / SEO / ANALYTICS ----------

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model SeoEntry {
  id             String    @id @default(cuid())
  path           String    @unique
  title          String
  description    String
  ogImage        String?
  focusKeyword   String?
  content        String?
  structuredData Json?
  publishedAt    DateTime?
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // page_view | lead | search | favorite | appointment | valuation | whatsapp
  path      String?
  source    String?
  medium    String?
  campaign  String?
  referrer  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, source, createdAt])
  @@index([campaign, createdAt])
}

// ---------- AGENCY BILLING ----------

enum AgencyPlan {
  STARTER
  PRO
  PREMIUM
  ENTERPRISE
}

enum AgencySubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum AgencyPaymentStatus {
  INITIATED
  PAID
  FAILED
  CANCELED
}

enum SubscriptionAlertType {
  EXPIRING_SOON
  PAST_DUE
}

model AgencySubscription {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               AgencyPlan
  status             AgencySubscriptionStatus @default(PENDING)
  amount             Int
  currency           String                   @default("MAD")
  provider           String                   @default("PAYTABS")
  providerProfileId  String?
  providerToken      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  payments           AgencyPayment[]
  alerts             SubscriptionAlert[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
}

model AgencyPayment {
  id                     String              @id @default(cuid())
  userId                 String
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId         String
  subscription           AgencySubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan                   AgencyPlan
  amount                 Int
  currency               String              @default("MAD")
  provider               String              @default("PAYTABS")
  cartId                 String              @unique
  providerTransactionRef String?
  status                 AgencyPaymentStatus @default(INITIATED)
  providerResponse       Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([userId, status, createdAt])
  @@index([providerTransactionRef])
}

model SubscriptionAlert {
  id             String               @id @default(cuid())
  subscriptionId String
  subscription   AgencySubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           SubscriptionAlertType
  periodKey      String
  sentAt         DateTime             @default(now())
  createdAt      DateTime             @default(now())

  @@unique([subscriptionId, type, periodKey])
  @@index([type, sentAt])
}
