{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/admin/crm/automation/run",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/admin/owner-reports/run",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/admin/billing/renew",
      "schedule": "30 7 * * *"
    }
  ]
}
